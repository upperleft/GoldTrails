# Server-only settings. Never commit a filled .env file.
# On Hostinger enter these under Environment variables, not into website code.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Required true for remote database hosts. Certificate validation remains enabled.
DB_SSL=false

# Owner-only creator workspace. Leave unset until the private setup is complete.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_ORIGIN=https://lightcoral-hedgehog-977933.hostingersite.com

# Existing member accounts (uses ADMIN_ORIGIN as fallback).
MEMBER_ORIGIN=https://lightcoral-hedgehog-977933.hostingersite.com
MEMBER_SIGNUP_ENABLED=false
RESEND_API_KEY=
MEMBER_MAIL_FROM=

# Compass works without AI. Choose a supported model explicitly to enable matching.
COMPASS_AI_ENABLED=false
OPENAI_API_KEY=
COMPASS_AI_MODEL=
